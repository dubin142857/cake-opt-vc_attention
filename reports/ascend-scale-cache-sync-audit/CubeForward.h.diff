+        const float q_scale_first = ReadQuantScale(q_scales_ + q_scale_base, q_scale_cache_line_);
@@ -542 +554 @@
-            ? ReadQuantScale(q_scales_ + q_scale_base + 1) : q_scale_first;
+            ? ReadQuantScale(q_scales_ + q_scale_base + 1, q_scale_cache_line_) : q_scale_first;
@@ -566 +578 @@
